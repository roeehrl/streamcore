{
  "description": "Client-side modifier latching (Pad's input protocol v2, Keyboard). Inputs use the stored convention: shift 1, control 2, option 4, command 8 = the primary modifier (⌘ on a Mac, Ctrl on Windows), platformKey 16 = the literal ⌘ / Windows key. Outputs are literal host bits (command 8 = ⌘ on a Mac, the Windows key on a PC). 'merge': requested ∪ latched ∪ held, made literal. 'route': committed text while modifiers are latched or held: plain text unless the merged modifiers include a shortcut modifier (Mac: ⌘ or Ctrl; Windows: Ctrl, Win or Alt); then one keyShortcut tap per character, letters lowercase, an uppercase letter adding Shift, newline/tab as the named keys. 'routeText' and 'routeKey' add what the host understands ('capabilities', its ServerState.capabilities): without textInput each character goes as a keyShortcut tap (replaceBefore as backspace taps first); without keyShortcut either, as KeyPackets at US positions (a tap is down then up, Shift added where the US key needs it) and characters with no US position are returned in 'unsent'. A key (routeKey: a Quick Key, a named key) is never text; 'requested' are its own stored modifiers; 'repeat' is kept only on a down. 'latchState' runs steps on one LatchState (method names as in the JSON method table, latchState.<method>, with the args shown): toggle latches or unlatches all given bits, holds count, one-shot latches clear after a key or shortcut text, keyPacket maps a hardware keyboard's Cmd to Ctrl on Windows, releaseAll returns ups (modifiers 0) for every key still down and clears everything but the one-shot setting.",
  "merge": [
    {"host": "mac", "requested": 0, "latched": 8, "held": 0, "expect": 8},
    {"host": "mac", "requested": 1, "latched": 8, "held": 0, "expect": 9},
    {"host": "mac", "requested": 0, "latched": 16, "held": 2, "expect": 10},
    {"host": "mac", "requested": 8, "latched": 16, "held": 0, "expect": 8},
    {"host": "windows", "requested": 0, "latched": 8, "held": 0, "expect": 2},
    {"host": "windows", "requested": 8, "latched": 1, "held": 0, "expect": 3},
    {"host": "windows", "requested": 0, "latched": 16, "held": 0, "expect": 8},
    {"host": "windows", "requested": 8, "latched": 16, "held": 4, "expect": 14},
    {"host": "windows", "requested": 2, "latched": 8, "held": 0, "expect": 2}
  ],
  "route": [
    {"name": "no latch: text", "host": "mac", "text": "Été", "latched": 0, "held": 0, "expect": {"text": "Été"}},
    {"name": "Shift alone stays text", "host": "mac", "text": "a", "latched": 1, "held": 0, "expect": {"text": "a"}},
    {"name": "Option alone stays text on a Mac", "host": "mac", "text": "å", "latched": 4, "held": 0, "expect": {"text": "å"}},
    {"name": "latched ⌘: shortcuts", "host": "mac", "text": "zS\n", "latched": 8, "held": 0, "expect": {"shortcuts": [{"key": {"char": "z"}, "modifiers": 8, "phase": "tap"}, {"key": {"char": "s"}, "modifiers": 9, "phase": "tap"}, {"key": {"named": "return"}, "modifiers": 8, "phase": "tap"}]}},
    {"name": "held Ctrl on a Mac", "host": "mac", "text": "\t1", "latched": 0, "held": 2, "expect": {"shortcuts": [{"key": {"named": "tab"}, "modifiers": 2, "phase": "tap"}, {"key": {"char": "1"}, "modifiers": 2, "phase": "tap"}]}},
    {"name": "Alt makes shortcuts on Windows", "host": "windows", "text": "f", "latched": 4, "held": 0, "expect": {"shortcuts": [{"key": {"char": "f"}, "modifiers": 4, "phase": "tap"}]}},
    {"name": "primary latch on Windows is Ctrl", "host": "windows", "text": "Z", "latched": 8, "held": 0, "expect": {"shortcuts": [{"key": {"char": "z"}, "modifiers": 3, "phase": "tap"}]}}
  ],
  "routeText": [
    {"name": "1.3 host: text with a replacement", "host": "mac", "text": "don't", "replaceBefore": 4, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "text", "message": {"text": "don't", "replaceBefore": 4}}], "unsent": ""}},
    {"name": "1.3 host: latched Cmd", "host": "mac", "text": "zS", "replaceBefore": 0, "latched": 8, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "z"}, "modifiers": 8, "phase": "tap"}}, {"type": "keyShortcut", "message": {"key": {"char": "s"}, "modifiers": 9, "phase": "tap"}}], "unsent": ""}},
    {"name": "no textInput: keyShortcut per character, backspaces first", "host": "windows", "text": "Hi\n", "replaceBefore": 1, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "keyShortcut"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"named": "backspace"}, "modifiers": 0, "phase": "tap"}}, {"type": "keyShortcut", "message": {"key": {"char": "h"}, "modifiers": 1, "phase": "tap"}}, {"type": "keyShortcut", "message": {"key": {"char": "i"}, "modifiers": 0, "phase": "tap"}}, {"type": "keyShortcut", "message": {"key": {"named": "return"}, "modifiers": 0, "phase": "tap"}}], "unsent": ""}},
    {"name": "1.2 host: US positions, Shift where the character needs it, unsent for the rest", "host": "mac", "text": "a+é", "replaceBefore": 0, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys"], "expect": {"messages": [{"type": "key", "packet": {"isDown": true, "hidUsage": 4, "modifiers": 0}}, {"type": "key", "packet": {"isDown": false, "hidUsage": 4, "modifiers": 0}}, {"type": "key", "packet": {"isDown": true, "hidUsage": 46, "modifiers": 1}}, {"type": "key", "packet": {"isDown": false, "hidUsage": 46, "modifiers": 1}}], "unsent": "é"}},
    {"name": "1.2 host with latched primary on Windows", "host": "windows", "text": "c", "replaceBefore": 0, "latched": 8, "held": 0, "capabilities": [], "expect": {"messages": [{"type": "key", "packet": {"isDown": true, "hidUsage": 6, "modifiers": 2}}, {"type": "key", "packet": {"isDown": false, "hidUsage": 6, "modifiers": 2}}], "unsent": ""}},
    {"name": "nothing to send", "host": "mac", "text": "", "replaceBefore": 0, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [], "unsent": ""}}
  ],
  "routeKey": [
    {"name": "Quick Key E is a key, not text", "host": "mac", "key": {"char": "e", "hid": 8}, "phase": "tap", "repeat": false, "requested": 0, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "e", "hid": 8}, "modifiers": 0, "phase": "tap"}}], "unsent": ""}},
    {"name": "stored primary + latched Shift on Windows", "host": "windows", "key": {"char": "z"}, "phase": "tap", "repeat": false, "requested": 8, "latched": 1, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "z"}, "modifiers": 3, "phase": "tap"}}], "unsent": ""}},
    {"name": "uppercase letter becomes Shift", "host": "mac", "key": {"char": "N"}, "phase": "tap", "repeat": false, "requested": 9, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "n"}, "modifiers": 9, "phase": "tap"}}], "unsent": ""}},
    {"name": "named key held with repeat", "host": "mac", "key": {"named": "right"}, "phase": "down", "repeat": true, "requested": 12, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"named": "right"}, "modifiers": 12, "phase": "down", "repeat": true}}], "unsent": ""}},
    {"name": "repeat only on down", "host": "mac", "key": {"named": "right"}, "phase": "tap", "repeat": true, "requested": 0, "latched": 0, "held": 0, "capabilities": ["hostAwareKeys", "textInput", "keyShortcut", "layoutInfo", "twoFinger", "penV2", "profiles", "noticeCodes", "hostStats"], "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"named": "right"}, "modifiers": 0, "phase": "tap"}}], "unsent": ""}},
    {"name": "1.2 host: named key as a KeyPacket", "host": "windows", "key": {"named": "f4"}, "phase": "tap", "repeat": false, "requested": 4, "latched": 0, "held": 0, "capabilities": [], "expect": {"messages": [{"type": "key", "packet": {"isDown": true, "hidUsage": 61, "modifiers": 4}}, {"type": "key", "packet": {"isDown": false, "hidUsage": 61, "modifiers": 4}}], "unsent": ""}},
    {"name": "1.2 host: a character with no US key uses its hid", "host": "mac", "key": {"char": "é", "hid": 31}, "phase": "down", "repeat": false, "requested": 8, "latched": 0, "held": 0, "capabilities": [], "expect": {"messages": [{"type": "key", "packet": {"isDown": true, "hidUsage": 31, "modifiers": 8}}], "unsent": ""}},
    {"name": "1.2 host: nothing to press", "host": "mac", "key": {"char": "é"}, "phase": "tap", "repeat": false, "requested": 0, "latched": 0, "held": 0, "capabilities": [], "expect": {"messages": [], "unsent": "é"}}
  ],
  "latchState": [
    {"name": "toggle, hold counts, one-shot, release all", "steps": [{"method": "toggle", "args": {"modifiers": 8}, "expect": 8}, {"method": "toggle", "args": {"modifiers": 9}, "expect": 9}, {"method": "toggle", "args": {"modifiers": 9}, "expect": 0}, {"method": "hold", "args": {"modifiers": 1}, "expect": 1}, {"method": "hold", "args": {"modifiers": 1}, "expect": 1}, {"method": "release", "args": {"modifiers": 1}, "expect": 1}, {"method": "release", "args": {"modifiers": 1}, "expect": 0}, {"method": "setOneShot", "args": {"oneShot": true}, "expect": null}, {"method": "toggle", "args": {"modifiers": 8}, "expect": 8}, {"method": "routeText", "args": {"text": "c", "host": "windows"}, "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "c"}, "modifiers": 2, "phase": "tap"}}], "unsent": ""}}, {"method": "state", "args": {}, "expect": {"latched": 0, "held": 0, "active": 0, "oneShot": true}}, {"method": "toggle", "args": {"modifiers": 1}, "expect": 1}, {"method": "routeText", "args": {"text": "a", "host": "mac"}, "expect": {"messages": [{"type": "text", "message": {"text": "a", "replaceBefore": 0}}], "unsent": ""}}, {"method": "state", "args": {}, "expect": {"latched": 1, "held": 0, "active": 1, "oneShot": true}, "note": "plain text does not use up a Shift latch"}]},
    {"name": "keys left down are released on disconnect", "steps": [{"method": "toggle", "args": {"modifiers": 8}, "expect": 8}, {"method": "routeKey", "args": {"key": {"named": "left"}, "phase": "down", "repeat": true, "host": "windows"}, "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"named": "left"}, "modifiers": 2, "phase": "down", "repeat": true}}], "unsent": ""}}, {"method": "routeKey", "args": {"key": {"char": "x"}, "phase": "down", "host": "windows"}, "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "x"}, "modifiers": 2, "phase": "down"}}], "unsent": ""}}, {"method": "routeKey", "args": {"key": {"char": "x"}, "phase": "up", "host": "windows"}, "expect": {"messages": [{"type": "keyShortcut", "message": {"key": {"char": "x"}, "modifiers": 2, "phase": "up"}}], "unsent": ""}}, {"method": "keyPacket", "args": {"packet": {"isDown": true, "hidUsage": 227, "modifiers": 8}, "host": "windows"}, "expect": {"isDown": true, "hidUsage": 224, "modifiers": 2}, "note": "Cmd on a hardware keyboard acts as Ctrl on Windows"}, {"method": "keyPacket", "args": {"packet": {"isDown": true, "hidUsage": 6, "modifiers": 8}, "host": "windows"}, "expect": {"isDown": true, "hidUsage": 6, "modifiers": 2}}, {"method": "releaseAll", "args": {}, "expect": {"keyShortcuts": [{"key": {"named": "left"}, "modifiers": 0, "phase": "up"}], "keyPackets": [{"isDown": false, "hidUsage": 224, "modifiers": 0}, {"isDown": false, "hidUsage": 6, "modifiers": 0}]}}, {"method": "state", "args": {}, "expect": {"latched": 0, "held": 0, "active": 0, "oneShot": false}}, {"method": "releaseAll", "args": {}, "expect": {"keyShortcuts": [], "keyPackets": []}}]}
  ]
}
