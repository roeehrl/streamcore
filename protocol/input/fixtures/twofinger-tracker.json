{
  "description": "The client's TwoFingerTracker: each frame gives the two touch points normalized to the content rect [x1, y1, x2, y2] and the content size in points [width, height]. The first frame returns 'began' with zero deltas; later frames return 'changed' with the change since the previous frame, or null when the points did not move. Points listed in the other order than before are matched back to the nearest previous point first (a swap is not a half turn), and contacts keep the matched order. Below 1 point of finger spacing, scale and rotation are 0. scale = d / d_prev - 1 (finger distance in points); rotation = change in the angle of p1->p2 in degrees, counter-clockwise on screen positive (y grows downward), wrapped to (-180, 180]; dx/dy = centroid movement in points; x/y = centroid and contacts = the points, normalized and clamped to 0...1. A frame whose size differs from the previous one re-baselines and returns null; a frame with a non-finite value or an empty size is ignored. end / cancel return a bare {kind, phase} 'ended' / 'cancelled', or null when idle. PadPad's TwoFingerSampler cases are in points on a 1000 x 1000 content rect. Numbers compare within 1e-6.",
  "cases": [
    {"name": "pinch out to twice the distance, then lift", "frames": [{"touches": [0.25, 0.5, 0.75, 0.5], "size": [400, 200], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.25, 0.5, 0.75, 0.5]}}, {"touches": [0.25, 0.5, 0.75, 0.5], "size": [400, 200], "expect": null}, {"touches": [0.0, 0.5, 1.0, 0.5], "size": [400, 200], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 1, "rotation": 0, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.0, 0.5, 1.0, 0.5]}}, {"touches": [0.125, 0.5, 0.875, 0.5], "size": [400, 200], "expect": {"kind": "twoFinger", "phase": "changed", "scale": -0.25, "rotation": 0, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.125, 0.5, 0.875, 0.5]}}, {"end": true, "expect": {"kind": "twoFinger", "phase": "ended"}}, {"end": true, "expect": null}]},
    {"name": "a quarter turn counter-clockwise on screen is +90", "frames": [{"touches": [0.25, 0.5, 0.75, 0.5], "size": [400, 400], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.25, 0.5, 0.75, 0.5]}}, {"touches": [0.5, 0.75, 0.5, 0.25], "size": [400, 400], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 90, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.5, 0.75, 0.5, 0.25]}}, {"touches": [0.25, 0.5, 0.75, 0.5], "size": [400, 400], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": -90, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.25, 0.5, 0.75, 0.5]}}, {"cancel": true, "expect": {"kind": "twoFinger", "phase": "cancelled"}}, {"cancel": true, "expect": null}]},
    {"name": "rotation wraps across 180 degrees", "frames": [{"touches": [0.5, 0.5, 0.0, 0.49], "size": [100, 100], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.25, "y": 0.495, "contacts": [0.5, 0.5, 0.0, 0.49]}}, {"touches": [0.5, 0.5, 0.0, 0.51], "size": [100, 100], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 2.2915256, "dx": 0, "dy": 1, "x": 0.25, "y": 0.505, "contacts": [0.5, 0.5, 0.0, 0.51]}}]},
    {"name": "pan in view points, positions clamped to the content", "frames": [{"touches": [0.8, 0.2, 0.9, 0.3], "size": [300, 100], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.85, "y": 0.25, "contacts": [0.8, 0.2, 0.9, 0.3]}}, {"touches": [0.9, 0.3, 1.0, 0.4], "size": [300, 100], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 0, "dx": 30, "dy": 10, "x": 0.95, "y": 0.35, "contacts": [0.9, 0.3, 1.0, 0.4]}}, {"touches": [1.0, 0.3, 1.1, 0.4], "size": [300, 100], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 0, "dx": 30, "dy": 0, "x": 1.0, "y": 0.35, "contacts": [1.0, 0.3, 1.0, 0.4]}}]},
    {"name": "a size change re-baselines; bad frames are ignored", "frames": [{"touches": [0.25, 0.5, 0.75, 0.5], "size": [400, 200], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.25, 0.5, 0.75, 0.5]}}, {"touches": [0.25, 0.5, 0.75, 0.5], "size": [200, 400], "expect": null}, {"touches": [0.0, 0.5, 1.0, 0.5], "size": [0, 400], "expect": null}, {"touches": [0.0, 0.5, 1.0, 0.5], "size": [200, 400], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 1, "rotation": 0, "dx": 0, "dy": 0, "x": 0.5, "y": 0.5, "contacts": [0.0, 0.5, 1.0, 0.5]}}]},
    {"source": "PadPad", "name": "spreading is positive scale, relative to the last frame", "frames": [{"touches": [0.1, 0.1, 0.2, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.1, 0.1, 0.2, 0.1]}}, {"touches": [0.09, 0.1, 0.21, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0.2, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.09, 0.1, 0.21, 0.1]}}, {"touches": [0.1, 0.1, 0.2, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": -0.16666666666666663, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.1, 0.1, 0.2, 0.1]}}]},
    {"source": "PadPad", "name": "counter-clockwise on screen is positive", "frames": [{"touches": [0.1, 0.1, 0.2, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.1, 0.1, 0.2, 0.1]}}, {"touches": [0.1, 0.1, 0.1984807753012208, 0.08263518223330696], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 10, "dx": -0.7596123493895988, "dy": -8.682408883346517, "x": 0.14924038765061037, "y": 0.09131759111665348, "contacts": [0.1, 0.1, 0.1984807753012208, 0.08263518223330696]}}, {"touches": [0.1, 0.1, 0.2, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": -10, "dx": 0.7596123493895988, "dy": 8.682408883346517, "x": 0.15, "y": 0.1, "contacts": [0.1, 0.1, 0.2, 0.1]}}]},
    {"source": "PadPad", "name": "pan is the centroid's movement in points", "frames": [{"touches": [0.1, 0.1, 0.2, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.1, 0.1, 0.2, 0.1]}}, {"touches": [0.103, 0.096, 0.203, 0.096], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 0, "dx": 3, "dy": -4, "x": 0.153, "y": 0.096, "contacts": [0.103, 0.096, 0.203, 0.096]}}]},
    {"source": "PadPad", "name": "swapped touches are matched back, not a half turn", "frames": [{"touches": [0.1, 0.1, 0.2, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.1, 0.1, 0.2, 0.1]}}, {"touches": [0.201, 0.1, 0.099, 0.1], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0.02, "rotation": 0, "dx": 0, "dy": 0, "x": 0.15, "y": 0.1, "contacts": [0.099, 0.1, 0.201, 0.1]}}]},
    {"source": "PadPad", "name": "no change, no message", "frames": [{"touches": [0.001, 0.002, 0.003, 0.004], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.002, "y": 0.003, "contacts": [0.001, 0.002, 0.003, 0.004]}}, {"touches": [0.001, 0.002, 0.003, 0.004], "size": [1000, 1000], "expect": null}]},
    {"source": "PadPad", "name": "rotation across the half turn wraps", "frames": [{"touches": [0.5, 0.5, 0.4, 0.501], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.45, "y": 0.5005, "contacts": [0.5, 0.5, 0.4, 0.501]}}, {"touches": [0.5, 0.5, 0.4, 0.499], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": -1.1458773953669719, "dx": 0, "dy": -1, "x": 0.45, "y": 0.4995, "contacts": [0.5, 0.5, 0.4, 0.499]}}]},
    {"source": "PadPad", "name": "fingers closer than a point report no scale or rotation", "frames": [{"touches": [0.5, 0.5, 0.5005, 0.5], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "began", "scale": 0, "rotation": 0, "dx": 0, "dy": 0, "x": 0.50025, "y": 0.5, "contacts": [0.5, 0.5, 0.5005, 0.5]}}, {"touches": [0.5, 0.5, 0.5, 0.5008], "size": [1000, 1000], "expect": {"kind": "twoFinger", "phase": "changed", "scale": 0, "rotation": 0, "dx": -0.25, "dy": 0.4, "x": 0.5, "y": 0.5004, "contacts": [0.5, 0.5, 0.5, 0.5008]}}]}
  ]
}
