    {"host": "windows", "appKey": "x.exe", "profile": {"schema": 1, "appKey": "x.exe", "name": "X", "updatedAt": "2026-01-01T00:00:00Z", "groups": [], "fallbacks": {"redo": {"key": {"char": "y", "hid": 28}, "modifiers": 9}}}, "expect": {"key": {"char": "y", "hid": 28}, "modifiers": 3, "phase": "tap"}, "note": "the app's own redo, primary = Ctrl"},
