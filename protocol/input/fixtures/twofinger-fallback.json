    {"name": "reset drops the remainder", "zoomStep": 0.25, "rotateStepDegrees": 15, "feeds": [{"scale": 0.2, "rotation": 14, "expect": [0, 0]}, {"reset": true}, {"scale": 0.05, "rotation": 2, "expect": [0, 0]}]},
