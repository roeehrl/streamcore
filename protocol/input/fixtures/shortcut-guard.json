    {"host": "windows", "character": null, "hid": 61, "modifiers": 2, "closing": true, "why": "Ctrl+F4 closes the document"},
    {"host": "windows", "character": "w", "hid": 29, "modifiers": 2, "closing": true},
    {"host": "windows", "character": "z", "hid": 29, "modifiers": 2, "closing": false},
    {"host": "windows", "character": "q", "hid": 20, "modifiers": 2, "closing": true, "why": "Ctrl+Q quits Krita, GIMP and Inkscape"},
    {"host": "windows", "character": null, "hid": 20, "modifiers": 3, "closing": true, "why": "unknown character: the US Q position"},
    {"host": "windows", "character": "a", "hid": 20, "modifiers": 2, "closing": false, "why": "AZERTY: the US Q position types A"},
    {"host": "windows", "character": "w", "hid": 26, "modifiers": 8, "closing": false, "why": "Win+W opens widgets, it doesn't close"}
  ],
  "decisions": [
    {"host": "mac", "message": {"key": {"char": "z", "hid": 29}, "modifiers": 8, "phase": "tap"}, "resolution": {"foundOnLayout": true, "fallbackTypes": null, "modifiers": 8}, "layout": "French", "expect": {"post": true, "useHid": false, "notice": null}, "name": "found on the layout"},
    {"host": "mac", "message": {"key": {"char": "z", "hid": 29}, "modifiers": 8, "phase": "tap"}, "resolution": {"foundOnLayout": false, "fallbackTypes": "w", "modifiers": 8}, "layout": "French", "expect": {"post": false, "useHid": false, "notice": {"code": "key.unavailable", "params": {"char": "z", "layout": "French"}}}, "name": "fallback would type Cmd+W"},
    {"host": "mac", "message": {"key": {"char": "z", "hid": 29}, "modifiers": 8, "phase": "tap"}, "resolution": {"foundOnLayout": false, "fallbackTypes": "y", "modifiers": 8}, "layout": "German", "expect": {"post": true, "useHid": true, "notice": null}, "name": "harmless fallback posts the hid"},
