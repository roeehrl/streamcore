    {"host": "windows", "message": {"key": {"char": "q", "hid": 20}, "modifiers": 2, "phase": "tap"}, "resolution": {"foundOnLayout": false, "fallbackTypes": null, "modifiers": 2}, "layout": "Russian", "expect": {"post": false, "useHid": false, "notice": {"code": "key.unavailable", "params": {"char": "q", "layout": "Russian"}}}, "name": "Ctrl+Q fallback"},
    {"host": "windows", "message": {"key": {"char": "w", "hid": 26}, "modifiers": 2, "phase": "up"}, "resolution": {"foundOnLayout": false, "fallbackTypes": null, "modifiers": 2}, "layout": "Russian", "expect": {"post": true, "useHid": true, "notice": null}, "name": "a key-up always passes"},
    {"host": "windows", "message": {"key": {"hid": 26}, "modifiers": 2, "phase": "tap"}, "resolution": {"foundOnLayout": false, "fallbackTypes": null, "modifiers": 2}, "layout": "Russian", "expect": {"post": true, "useHid": true, "notice": null}, "name": "a bare hid position is explicit"}
  ],
